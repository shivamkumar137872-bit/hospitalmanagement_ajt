<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ page import="model.Patient" %>
<%
    Patient p = (Patient) request.getAttribute("patient");
    if (p == null) {
        response.sendRedirect("patient?action=list");
        return;
    }
%>
<!DOCTYPE html>
<html>
<head>
    <title>Patient Medical Slip - #<%= p.getPatientId() %></title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        @media print {
            .no-print { display: none !important; }
            body { padding: 0; }
        }
    </style>
</head>
<body class="container py-5" style="max-width: 700px;">
    <div class="card p-4 border shadow-sm">
        <div class="d-flex justify-content-between border-bottom pb-3 mb-4">
            <div>
                <h3 class="mb-0 text-primary">CITY GENERAL HOSPITAL</h3>
                <small class="text-muted">Outpatient & Inpatient Medical Report</small>
            </div>
            <div class="text-end">
                <span class="badge bg-secondary">Patient ID: #<%= p.getPatientId() %></span>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-6">
                <strong>Patient Name:</strong> 
                <p class="fs-5 text-dark"><%= p.getName() %></p>
            </div>
            <div class="col-3">
                <strong>Age:</strong> 
                <p class="fs-5 text-dark"><%= p.getAge() %> yrs</p>
            </div>
            <div class="col-3">
                <strong>Gender:</strong> 
                <p class="fs-5 text-dark"><%= p.getGender() %></p>
            </div>
            <div class="col-6">
                <strong>Phone Number:</strong> 
                <p><%= p.getPhone() %></p>
            </div>
            <div class="col-6">
                <strong>Primary Diagnosis:</strong> 
                <p class="text-danger fw-bold"><%= p.getDisease() %></p>
            </div>
            <div class="col-12">
                <strong>Address:</strong> 
                <p><%= p.getAddress() %></p>
            </div>
        </div>

        <div class="border-top pt-4 mt-4 d-flex justify-content-between align-items-center">
            <small class="text-muted">Generated by: <%= session.getAttribute("user") %></small>
            <div class="text-end">
                <p class="mb-0 border-top pt-2" style="width: 150px; text-align: center;">Doctor's Sign</p>
            </div>
        </div>
    </div>

    <div class="mt-3 text-center no-print">
        <button onclick="window.print()" class="btn btn-primary px-4 me-2">Print / Save as PDF</button>
        <a href="patient?action=list" class="btn btn-secondary px-4">Back to List</a>
    </div>
</body>
</html>